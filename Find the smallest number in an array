#include<bits/stdc++.h>
using namespace std;

int fun(vector<int>&arr, int n){
    int min =arr[0];
    for(int i = 0; i < n; i++){
        if(min>arr[i]){
            min = arr[i];
        }
    }
    return min;
}
int main(){
    int n ;
    cin>>n;
    
    vector<int>arr(n);
    for(int i = 0; i < n; i++){
        cin>>arr[i];
    }
    cout<<fun(arr,n);
    return 0;
}
